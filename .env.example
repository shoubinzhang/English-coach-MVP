# Auth — choose ONE of the two options below.
#
# Option A: Anthropic API key (pay-as-you-go billing).
#   Get it from https://console.anthropic.com → Settings → API keys.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Option B: Claude Pro/Max subscription via Claude Code CLI.
#   1. npm install -g @anthropic-ai/claude-code
#   2. claude login   (opens browser, signs in with your Claude account)
#   3. Leave ANTHROPIC_API_KEY unset (or commented out) here.
#   The app's /api/chat will auto-fall-back to the Claude Agent SDK, which
#   reuses the local `claude login` credentials.

# M4 — Pronunciation assessment (optional; required for /pronunciation)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# DB file location (defaults to ./data/coach.db)
DB_PATH=./data/coach.db
